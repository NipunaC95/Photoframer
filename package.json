{
  "name": "photoframer",
  "version": "1.0.0",
  "description": "Photoframer — Antigravity-styled Batch Image Aspect Ratio Padding & Watermark Studio",
  "author": "Antigravity Principal Engineering",
  "license": "MIT",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"node scripts/dev-runner.js\"",
    "build:renderer": "vite build",
    "build:main": "vite build --config vite.config.main.ts",
    "build": "npm run build:renderer && npm run build:main",
    "test:pipeline": "node scripts/test-batch-pipeline.js",
    "generate:samples": "node scripts/generate-sample-assets.js",
    "preview": "vite preview",
    "start": "electron ."
  },
  "dependencies": {
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.14",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "electron": "^33.2.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
